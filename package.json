{
  "name": "the-montessorians",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "The largest open source dataset of Montessori alumni, and the website that renders it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renaissanceabc/the-montessorians.git"
  },
  "homepage": "https://github.com/renaissanceabc/the-montessorians#readme",
  "bugs": {
    "url": "https://github.com/renaissanceabc/the-montessorians/issues"
  },
  "scripts": {
    "analyze": "turbo analyze",
    "build": "turbo build && bun format",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker",
    "clean": "git clean -xdf node_modules .next",
    "clean:all": "rm -f bun.lock && find . -name 'node_modules' -type d -exec rm -rf {} + 2>/dev/null || true && find . -name '.next' -type d -exec rm -rf {} + 2>/dev/null || true && find . -name '.turbo' -type d -exec rm -rf {} + 2>/dev/null || true && find . -name 'dist' -type d -exec rm -rf {} + 2>/dev/null || true",
    "dev": "turbo dev --parallel",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "validate": "node scripts/validate.js",
    "data:format": "prettier --write \"data/**/*.yaml\"",
    "data:lint": "prettier --check \"data/**/*.yaml\" && bun run validate",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky",
    "test": "turbo test --parallel",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.4.7",
      "@commitlint/cli": "^20.5.0",
      "@commitlint/config-conventional": "^20.5.0",
      "@hookform/resolvers": "^5.2.2",
      "@logtail/next": "^0.3.0",
      "@next/bundle-analyzer": "16.1.1",
      "@next/third-parties": "16.1.1",
      "@react-email/components": "1.0.4",
      "@react-email/preview-server": "5.2.10",
      "@react-email/render": "^2.0.2",
      "@sentry/nextjs": "^10.32.1",
      "@t3-oss/env-core": "^0.13.10",
      "@t3-oss/env-nextjs": "^0.13.10",
      "@tailwindcss/postcss": "^4",
      "@tailwindcss/typography": "^0.5.19",
      "@tanstack/react-query": "^5.90.16",
      "@tanstack/react-query-devtools": "^5.91.2",
      "@types/bun": "^1.3.5",
      "@types/js-yaml": "^4.0.9",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/lodash.merge": "^4.6.9",
      "@types/node": "^25.0.6",
      "@types/pg": "^8.16.0",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@upstash/ratelimit": "^2.0.7",
      "@upstash/redis": "^1.36.1",
      "@vercel/analytics": "^1.6.1",
      "@vercel/blob": "^2.0.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.1.0",
      "dotenv": "^17.2.3",
      "drizzle-kit": "^0.31.8",
      "drizzle-orm": "^0.45.1",
      "embla-carousel-react": "^8.6.0",
      "framer-motion": "^12.25.0",
      "husky": "^9.1.7",
      "import-in-the-middle": "2.0.1",
      "js-yaml": "^4.1.1",
      "jsonwebtoken": "^9.0.3",
      "lint-staged": "^16.4.0",
      "lodash.merge": "^4.6.2",
      "lucide-react": "^0.562.0",
      "next": "^16.1.1",
      "next-themes": "^0.4.6",
      "nuqs": "^2.8.6",
      "postgres": "^3.4.8",
      "posthog-js": "^1.318.1",
      "posthog-node": "^5.20.0",
      "prettier": "^3.7.4",
      "radix-ui": "latest",
      "react": "^19.2.3",
      "react-day-picker": "^9.11.1",
      "react-dom": "^19.2.3",
      "react-email": "5.2.10",
      "react-hook-form": "^7.71.0",
      "recharts": "^3.6.0",
      "require-in-the-middle": "8.0.1",
      "resend": "^6.7.0",
      "@trpc/client": "^11.13.0",
      "@trpc/server": "^11.13.0",
      "@trpc/tanstack-react-query": "^11.13.0",
      "server-only": "^0.0.1",
      "sonner": "^2.0.7",
      "superjson": "^2.2.6",
      "tailwind-merge": "^3.4.0",
      "tailwindcss": "^4",
      "tsup": "^8.5.1",
      "turbo": "^2.9.6",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5.9.3",
      "ultracite": "7.3.2",
      "use-debounce": "^10.1.0",
      "vaul": "^1.1.2",
      "zod": "^4.3.5"
    }
  },
  "overrides": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "all-contributors-cli": "^6.26.1",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "dependencies": {
    "import-in-the-middle": "catalog:",
    "require-in-the-middle": "catalog:"
  }
}
