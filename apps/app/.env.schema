# Every env var the site and the packages it bundles read: where it comes
# from, its type, whether it's required, and whether it's secret. Varlock
# validates this during `next dev`, `next build` and `next start`, so a
# missing or malformed value fails the build, and anything not marked @public
# is redacted from logs and blocked from the client bundle.
#
# This file holds names and rules only, never a value. On Vercel, values come
# from Infisical through OIDC, so no Infisical credential exists anywhere:
# `the-montessorians` holds dev and staging (Vercel Preview reads staging),
# `the-montessorians-prod` holds prod. The IDs below are not secrets. Only the
# two Vercel identities can read these projects; no CI job needs a value. The
# fetch is off everywhere else: laptops use `infisical run`, CI and tests run
# with APP_ENV=test, and a value already in process.env (a Vercel or
# integration var) wins over Infisical.
#
# @currentEnv=$APP_ENV
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=if(forEnv(production), "493a19bb-f6f0-484d-a9e6-27e0aa7839d2", "70de411b-e813-47d6-9ac4-a1e950a358e8"),
#   environment=remap($APP_ENV, production, prod, preview, staging, staging, staging, dev),
#   identityId=if(forEnv(production), "07371204-f858-4069-a271-9b58533f687c", "7d4a4c33-c8cd-4bbb-b06e-0e12a3111989")
# )
# @setValuesBulk(infisicalBulk(), enabled=and(eq($VARLOCK_PLATFORM, "Vercel"), not(forEnv(development, test))))
# @defaultRequired=false
# @redact={stdout=true}
# @generateTsTypes(path=env.d.ts)
# ---

# Picks `.env.[env]` files and which items are required. Varlock derives it
# from VERCEL_ENV on Vercel and detects test runners; CI sets it to `test`.
# @public @type=enum(development, preview, staging, production, test)
APP_ENV=$VARLOCK_ENV

# --- Platform (set by Vercel, Next, Node or the dev tooling) ---

# @public
NODE_ENV=
# @public
NEXT_RUNTIME=
# @public
CI=
# @public @type=enum(production, preview, development)
VERCEL_ENV=
# @public @type=enum(production, preview, development)
NEXT_PUBLIC_VERCEL_ENV=
# @public
VERCEL_URL=
# @public
VERCEL_PROJECT_PRODUCTION_URL=
# portless sets it in `bun dev` (montessorians.localhost).
# @public @type=url
PORTLESS_URL=
# @public @type=port
PORT=
# The site's public origin for the few pages that need an absolute URL.
# @public @type=url
SITE_URL=
# `bun run analyze` sets it to wrap the build in the bundle analyzer.
# @public @type=enum(true, false)
ANALYZE=

# --- Analytics (public: they ship to the browser) ---

# Required on Vercel, optional locally, where analytics are skipped.
# @public @required=forEnv(preview, staging, production) @type=string(startsWith=phc_)
NEXT_PUBLIC_POSTHOG_KEY=
# @public @required=forEnv(preview, staging, production) @type=url
NEXT_PUBLIC_POSTHOG_HOST=
# @public @type=string(startsWith=G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Observability ---

# Added by the Sentry integration (Vercel Marketplace). Sentry is off without it.
# @public @type=url
NEXT_PUBLIC_SENTRY_DSN=
# @public
SENTRY_ORG=
# @public
SENTRY_PROJECT=
# Uploads source maps during `next build`. Set by the Sentry integration and
# read only by the Sentry build plugin, so the code never names it.
# @sensitive @auditIgnore
SENTRY_AUTH_TOKEN=

# Better Stack uptime API for the status badge; logging turns on with it.
# @sensitive
BETTERSTACK_API_KEY=
# @sensitive @type=url
BETTERSTACK_URL=

# --- Contribute form ---

# Fine-grained token with "Issues: write" on this repo. Without it the
# contribute form falls back to opening a prefilled GitHub issue.
# @sensitive
GITHUB_SUBMISSIONS_TOKEN=
