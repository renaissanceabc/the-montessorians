{
  "name": "app",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "node scripts/generate-content.mjs && portless --name montessorians -- next dev --turbopack",
    "dev:port": "node scripts/generate-content.mjs && next dev -p 3010 --turbopack",
    "build": "node scripts/generate-content.mjs && next build --turbopack",
    "start": "next start",
    "analyze": "ANALYZE=true bun build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "node scripts/generate-content.mjs && varlock codegen && tsc --noEmit --emitDeclarationOnly false",
    "test": "node scripts/generate-content.mjs && bun test lib"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@montessorians/next-config": "workspace:*",
    "@montessorians/observability": "workspace:*",
    "@varlock/nextjs-integration": "2.0.0",
    "botid": "^1.5.11",
    "class-variance-authority": "catalog:",
    "cn": "^0.4.0",
    "date-fns": "catalog:",
    "import-in-the-middle": "catalog:",
    "js-yaml": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.90.0",
    "require-in-the-middle": "catalog:",
    "sonner": "catalog:",
    "use-debounce": "catalog:",
    "varlock": "1.24.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@montessorians/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "agentation": "^3.1.2",
    "portless": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  }
}
