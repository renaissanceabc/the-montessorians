#!/bin/sh
# Catches a missing changeset before CI's "Require changeset" check does.
# Chore, docs, and refactor PRs that get the skip-changeset label can push past
# this with `git push --no-verify`.
branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  develop | main | changeset-release/*) exit 0 ;;
esac

git rev-parse --verify --quiet origin/develop >/dev/null || exit 0

if ! bunx changeset status --since=origin/develop >/dev/null 2>&1; then
  echo "❌ No changeset for the packages this branch changes."
  echo "   Add one with: bunx changeset"
  echo "   Or, for a skip-changeset PR: git push --no-verify"
  exit 1
fi
